# Environments & secrets
.venv/
venv/
.env

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Data (originals live outside the repo; extracted/processed copies are regenerated)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Generated artifacts (regenerate via scripts/run_pipeline.py)
models/*
!models/.gitkeep
results/**/*.parquet
results/cache/
logs/
*.zip

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
